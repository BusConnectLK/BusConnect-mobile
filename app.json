{
  "expo": {
    "name": "BusConnect",
    "slug": "BusConnect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/applogo.png",
    "scheme": "busconnectmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/applogo.png",
      "bundleIdentifier": "lk.busconnect.app",
      "appleTeamId": "B9Z73W94NU",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lk.busconnect.app",
      "adaptiveIcon": {
        "backgroundColor": "#004AAD",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#004AAD",
          "image": "./assets/images/applogo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "BusConnect needs access to your photos to set a profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d39ea5d-73d7-4ba6-92e4-038882f347eb"
      }
    },
    "owner": "myscope"
  }
}
